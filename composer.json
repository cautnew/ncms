{
    "name": "cautnew/ncms",
    "type": "project",
    "description": "Any CMS, fast, manageble, optimized.",
    "keywords": ["ncms", "cms", "laravel", "framework"],
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Martins",
            "email": "felipedesmartins@gmail.com",
            "homepage": "http://www.cautnew.com.br",
            "role": "Back-End Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:cautnew/qb.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:cautnew/summernote.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.9",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "cautnew/qb": ">=0.8.18",
        "cautnew/summernote": ">=0.8.18",
        "fortawesome/font-awesome": "^6.5",
        "twbs/bootstrap": "5.3.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "PHTML\\": "vendor/cautnew/phtml/src",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
